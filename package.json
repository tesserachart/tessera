{
  "name": "tessera",
  "private": true,
  "license": "Apache-2.0",
  "description": "Tessera: agent-first multi-asset trading workspace (TypeScript workspace root).",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --cwd=apps/desktop run dev",
    "build": "bun --cwd=apps/desktop run build",
    "serve": "bun run build && node apps/desktop/scripts/serve.ts",
    "test": "bun run gen:check && bun run gen:schemas:check && bun run test:ts && bun run test:rust",
    "test:ts": "vitest run",
    "test:rust": "RUSTC_WRAPPER=${RUSTC_WRAPPER-$(command -v sccache)} cargo nextest run --workspace",
    "test:shell": "RUSTC_WRAPPER=${RUSTC_WRAPPER-$(command -v sccache)} cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:perf:report": "TESSERA_PERF_REPORT=1 vitest run --config vitest.perf.config.ts --silent=false",
    "bench:chart": "node apps/desktop/scripts/bench-chart.ts",
    "lint": "eslint . --max-warnings=0 --concurrency=auto",
    "knip": "knip --treat-config-hints-as-errors",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p . && tsc --noEmit -p e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "bun --cwd=packages/protocol run gen",
    "gen:check": "bun --cwd=packages/protocol run gen:check",
    "gen:schemas": "bun --cwd=packages/protocol run gen:schemas",
    "gen:schemas:check": "bun --cwd=packages/protocol run gen:schemas:check",
    "e2e:install": "playwright install chromium",
    "e2e:agent": "bun scripts/e2e-agent.ts",
    "e2e:agent:ci": "bun scripts/e2e-agent.ts --ci",
    "e2e:tauri": "bun scripts/e2e-tauri.ts",
    "tauri:dev": "bun --cwd=apps/desktop run tauri:dev",
    "tauri:build": "bun --cwd=apps/desktop run tauri:build",
    "check": "bun scripts/check.ts",
    "smoke": "bun scripts/release-smoke.ts",
    "comments": "bun scripts/comments.ts",
    "evidence": "bun scripts/evidence.ts",
    "site:dev": "bun --cwd=apps/site run dev",
    "site:build": "bun --cwd=apps/site run build",
    "voices": "bun scripts/voices/generate.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.83",
    "@e2e-dev/web": "0.11.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "ai": "7.0.127",
    "e2e": "0.16.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "knip": "6.44.1",
    "pixelmatch": "7.1.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "trustedDependencies": [],
  "overrides": {
    "zod": "4.6.5"
  }
}
