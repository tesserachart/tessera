---
import { LEGAL_UPDATED } from '../config';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  sections: { id: string; title: string }[];
  updated?: string;
}
const { title, description, sections, updated = LEGAL_UPDATED } = Astro.props;
---

<Base title={title} description={description} compactNav>
  <article class="legal wrap">
    <header class="head">
      <p class="dateline serif">Last updated {updated}</p>
      <h1 class="display-s">{title}</h1>
    </header>
    <div class="body">
      <nav class="toc" aria-label="Contents">
        <p class="toc-h serif">Contents</p>
        <ol>
          {sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.title}</a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-top: clamp(128px, 14vw, 184px);
    padding-bottom: clamp(96px, 10vw, 160px);
  }
  .head {
    display: grid;
    gap: 20px;
    max-width: 52rem;
    padding-bottom: clamp(40px, 5vw, 64px);
    border-bottom: 1px solid var(--line);
  }
  .dateline {
    font-size: 1.25rem;
    color: var(--t2);
  }
  .body {
    display: grid;
    grid-template-columns: 15rem minmax(0, 46rem);
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(40px, 5vw, 64px);
  }
  .toc {
    position: sticky;
    top: 104px;
    align-self: start;
  }
  .toc-h {
    font-size: 1.25rem;
    margin-bottom: 12px;
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
    font-size: 0.9375rem;
  }
  .toc a {
    color: var(--t3);
    transition: color var(--dur-hover) linear;
  }
  .toc a:hover {
    color: var(--t1);
  }
  .prose {
    color: var(--t2);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-family: var(--serif);
    font-size: 1.875rem;
    line-height: 1.15;
    color: var(--t1);
    margin: 56px 0 16px;
    scroll-margin-top: 104px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--t1);
    margin: 28px 0 8px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 16px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25em;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(strong) {
    color: var(--t1);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--t1);
    text-decoration: underline;
    text-decoration-color: var(--line-3);
    text-underline-offset: 0.2em;
  }
  .prose :global(.caps) {
    font-weight: 600;
    color: var(--t1);
  }
  @media (max-width: 899px) {
    .body {
      grid-template-columns: 1fr;
    }
    .toc {
      position: static;
    }
  }
</style>
