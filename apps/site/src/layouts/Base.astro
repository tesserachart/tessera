---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { DESCRIPTION, NAME, TAGLINE } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  compactNav?: boolean;
  noindex?: boolean;
}

const { title, description = DESCRIPTION, compactNav = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${NAME}` : `${NAME} · ${TAGLINE}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const motionFlag = `document.documentElement.dataset.motion=matchMedia('(prefers-reduced-motion: reduce)').matches?'reduced':'full'`;
---

<!doctype html>
<html lang="en" data-motion="reduced">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#05070c" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${NAME}: ${TAGLINE}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload />
    <script is:inline set:html={motionFlag} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Nav compact={compactNav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
