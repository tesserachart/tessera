---
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p';
  class?: string;
  delayMs?: number;
  id?: string;
}
const { text, as: Tag = 'h2', class: cls, delayMs = 0, id } = Astro.props;
const lines = text.split('|').map((l) =>
  l
    .trim()
    .split(/\s+/)
    .map((w) => ({ word: w.replace(/\*/g, ''), em: /^\*.*\*[.,;:]?$/.test(w) })),
);
const plain = text.replace(/[|*]/g, ' ').replace(/\s+/g, ' ').trim();
let i = 0;
---

<Tag class:list={['words', cls]} style={`--d0:${String(delayMs)}ms`} id={id} aria-label={plain}>
  {lines.map((words, li) => (
    <>
      {li > 0 && <br />}
      {words.map((w, wi) => (
        <>
          {wi > 0 && ' '}
          <span class="w" aria-hidden="true">
            <span style={`--i:${String(i++)}`}>{w.em ? <em>{w.word}</em> : w.word}</span>
          </span>
        </>
      ))}
    </>
  ))}
</Tag>
