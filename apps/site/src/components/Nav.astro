---
import wordmarkUrl from '@tessera/ui/brand/wordmark-text.svg?url';
import { APPLY_URL } from '../config';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const home = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const href = (hash: string) => (home ? hash : `/${hash}`);
const links = [
  { label: 'Chart', hash: '#chart' },
  { label: 'Order flow', hash: '#order-flow' },
  { label: 'Agent', hash: '#agent' },
  { label: 'Your AI', hash: '#your-ai' },
];
---

<header class="nav" data-nav>
  <div class="nav-in wrap">
    <a class="brand" href="/" aria-label="Tessera, home">
      <img src={wordmarkUrl} alt="" width="92" height="29" />
    </a>
    {!compact && (
      <nav class="links" aria-label="Sections">
        {links.map((l) => (
          <a href={href(l.hash)}>{l.label}</a>
        ))}
      </nav>
    )}
    <a class="btn btn-primary btn-s cta" href={APPLY_URL}>
      Request access
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 72px;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      transform 420ms var(--ease-out-strong),
      background-color 200ms linear,
      border-color 200ms linear;
  }
  .nav.is-solid {
    background: var(--ink);
    border-bottom-color: var(--line);
  }
  .nav.is-hidden {
    transform: translate3d(0, -100%, 0);
  }
  .nav-in {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .brand {
    justify-self: start;
    display: block;
    padding: 6px 0;
  }
  .brand img {
    height: 29px;
    width: auto;
  }
  .links {
    display: flex;
    gap: clamp(20px, 2.6vw, 40px);
    font-size: 0.9375rem;
    color: var(--t2);
  }
  .links a {
    padding: 8px 0;
    transition: color var(--dur-hover) linear;
  }
  .links a:hover {
    color: var(--t1);
  }
  .cta {
    justify-self: end;
    grid-column: 3;
  }
  @media (max-width: 820px) {
    .links {
      display: none;
    }
  }
</style>
