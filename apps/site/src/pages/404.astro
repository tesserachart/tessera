---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page does not exist." compactNav noindex>
  <section class="nf wrap">
    <p class="dateline serif">404</p>
    <h1 class="display">Nothing here.</h1>
    <p class="lede">The page you asked for does not exist or has moved.</p>
    <a class="btn btn-primary" href="/">
      Back to Tessera
    </a>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 24px;
    padding-top: 120px;
    padding-bottom: 96px;
  }
  .dateline {
    font-size: 1.25rem;
    color: var(--t3);
  }
</style>
