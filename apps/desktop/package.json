{
  "name": "desktop",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Tessera desktop UI (Vite + React) and Tauri 2 shell.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && bun scripts/symbols.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.ts",
    "tauri:build": "bun scripts/prepare-sidecar.ts && tauri build --config src-tauri/tauri.bundle.conf.json",
    "dev:shell-ui": "TESSERA_RUNTIME=none vite"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@floating-ui/dom": "1.8.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "3.14.13",
    "@tessera/bridge": "workspace:*",
    "@tessera/chart": "workspace:*",
    "@tessera/protocol": "workspace:*",
    "@tessera/ui": "workspace:*",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@visx/axis": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/vendor": "4.0.0",
    "cmdk": "1.1.1",
    "dockview-react": "8.4.0",
    "modern-screenshot": "4.7.0",
    "posthog-js": "1.438.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "vite": "8.3.2"
  }
