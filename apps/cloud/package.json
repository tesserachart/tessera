{
  "name": "@tessera/cloud",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Tessera Cloud: the Cloudflare Worker the app and the site talk to (accounts, alpha access, check-ins).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging --ip 127.0.0.1 --local-upstream 127.0.0.1:8787 --upstream-protocol http",
