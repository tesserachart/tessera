    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tessera/ui": "workspace:*",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/mdast": "4.0.4",
    "jsonc-parser": "3.3.1",
    "miniflare": "4.20260730.0",
    "wrangler": "4.151.1"
  }
}
